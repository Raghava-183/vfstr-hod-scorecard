# Neon Postgres — added automatically by the Vercel Marketplace integration
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The single password every faculty member types to sign in.
# Use a long passphrase. Change it at the end of the review cycle.
DEPT_PASSWORD=change-this-to-a-long-passphrase

# Any long random string. Signs the session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-string

# Cloudinary — Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
